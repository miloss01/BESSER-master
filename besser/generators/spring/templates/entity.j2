package {{ package_name }};

{% for import in imports -%}
import {{ import }};
{% endfor -%}

{% if is_abstract %}
@MappedSuperclass
{% else %}
@Entity
@Table(name="{{ table_name }}")
{% endif -%}
public{% if is_abstract %} abstract{% endif %} class {{ cls.name }}{% if parent %} extends {{parent}}{% endif %} {
    {% for attribute in attributes -%}
    {% if attribute.is_id %}
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    {%- endif %}
    {% if attribute.is_enum -%}
    @Enumerated(EnumType.STRING)
    {% else -%}
    @Column(name = "{{ attribute.column_name }}"{% if not attribute.is_optional %}, nullable = false{% endif %})
    {% endif %}
    {{- attribute.visibility }} {{ attribute.type }} {{ attribute.name }}{% if attribute.default_value %} = {{ attribute.default_value }}{% endif %};
    {% endfor -%}

    {% if not is_abstract %}
    public {{ cls.name }}() { }

    public {{ cls.name }}(
    {%- for attribute in attributes -%}
    {{ attribute.type }} {{ attribute.name }}{% if not loop.last %}, {% endif %}
    {%- endfor %}) {
        {%- for attribute in attributes %}
        this.{{ attribute.name }} = {{ attribute.name }};
        {%- endfor %}
    }
    {% endif -%}

    {% for attribute in attributes %}
    public {{ attribute.type }} get{{ attribute.name | capitalize }}() {
        return this.{{ attribute.name }};
    }

    public void set{{ attribute.name | capitalize }}({{ attribute.type }} {{ attribute.name }}) {
        this.{{ attribute.name }} = {{ attribute.name }};
    }
    {% endfor %}
}